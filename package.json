{
  "name": "dmt-task-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Task management UI",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.js",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run tokens",
    "test": "TZ=Asia/Kolkata vitest run",
    "test:watch": "TZ=Asia/Kolkata vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "lint": "eslint . && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "msw": "^3.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
