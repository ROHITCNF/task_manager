# Data source: mock (MSW in the browser) | live (real backend). ADR-0006.
VITE_API_MODE=mock
# Base URL of the API (same-origin path recommended). ADR-0011.
VITE_API_BASE_URL=/api/v1
# Sign-in flow: mock (POST /auth/mock-login) | google (backend OAuth redirect). ADR-0012.
VITE_AUTH_MODE=mock
# Request timeout in ms.
VITE_REQUEST_TIMEOUT_MS=15000
# Dev server only: proxy /api to a local backend when VITE_API_MODE=live.
# VITE_API_PROXY_TARGET=http://localhost:8080
